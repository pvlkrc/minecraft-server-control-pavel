RCON_PASSWORD=<RCON PASS>
RCON_PORT=25575

# Web panel login
PANEL_USER=admin
PANEL_PASSWORD=<PANEL PASS>

# Where the panel listens. 127.0.0.1 = this computer only, 0.0.0.0 = whole LAN.
PANEL_BIND=127.0.0.1
PANEL_PORT=8000

# api image from GHCR. Pin a version (e.g. 1.0.0 or sha-abc1234) instead of latest
# if you want updates only when you change this.
API_TAG=latest
