RCON_PASSWORD=<RCON PASS>
RCON_PORT=25575

# Minecraft version (pinned). Back up ./data before you change it.
MC_VERSION=26.3

# Web panel login
PANEL_USER=admin
PANEL_PASSWORD=<PANEL PASS>

# Where the panel listens. 0.0.0.0 = from everywhere, 127.0.0.1 = this computer only.
# The panel uses plain HTTP: use a long PANEL_PASSWORD, ideally put HTTPS in front.
PANEL_BIND=0.0.0.0
PANEL_PORT=8000

# api image from GHCR. Pin a version (e.g. 1.0.0 or sha-abc1234) instead of latest
# if you want updates only when you change this.
API_TAG=latest
